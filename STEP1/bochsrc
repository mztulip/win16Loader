###############################################
# bochsrc - konfiguracja Bochs dla Win16 test
###############################################

cpu: model=p3_katmai, count=1, ips=10000000
megs: 16

romimage:    file=/usr/share/bochs/BIOS-bochs-latest
vgaromimage: file=/usr/share/bochs/VGABIOS-lgpl-latest.bin

# Dyskietka 1.44MB z FreeDOS + hello.com
floppya: 1_44=boot.img, status=inserted

# Bootuj z dyskietki
boot: a

# VGA text mode
display_library: x

# Log
log: bochs.log
logprefix: %t%e%d
