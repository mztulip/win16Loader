#include <windows.h>
#include "paint.h"

1 ICON "PAINT.ICO"

IDD_CANVAS_SIZE DIALOG 20, 20, 185, 112
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Canvas Size"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Dimensions", -1, 7, 7, 105, 54
    LTEXT           "Width:", -1, 15, 22, 28, 8
    EDITTEXT        IDC_CANVAS_W, 46, 20, 40, 12, ES_AUTOHSCROLL
    LTEXT           "px", -1, 90, 22, 16, 8
    LTEXT           "Height:", -1, 15, 42, 28, 8
    EDITTEXT        IDC_CANVAS_H, 46, 40, 40, 12, ES_AUTOHSCROLL
    LTEXT           "px", -1, 90, 42, 16, 8

    GROUPBOX        "Presets", -1, 7, 65, 171, 40
    PUSHBUTTON      "320x200", IDC_PRESET_320, 12, 78, 36, 14
    PUSHBUTTON      "640x480", IDC_PRESET_640, 51, 78, 36, 14
    PUSHBUTTON      "800x600", IDC_PRESET_800, 90, 78, 36, 14
    PUSHBUTTON      "Default",  IDC_PRESET_DEF, 130, 78, 42, 14

    DEFPUSHBUTTON   "OK", IDOK, 122, 12, 56, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 122, 32, 56, 14
END
