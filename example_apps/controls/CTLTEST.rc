#include <windows.h>
#include "ctltest.h"

IDI_APP ICON "../app.ico"

IDD_MAIN DIALOG 10, 10, 260, 170
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE | DS_MODALFRAME
CAPTION "Kontrolki - test"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Przyciski", -1, 5, 5, 95, 75
    CHECKBOX        "Checkbox", IDC_CHECK, 12, 17, 80, 12, BS_AUTOCHECKBOX | WS_TABSTOP
    RADIOBUTTON     "Radio A", IDC_RADIO1, 12, 31, 80, 12, BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP
    RADIOBUTTON     "Radio B", IDC_RADIO2, 12, 45, 80, 12, BS_AUTORADIOBUTTON
    CONTROL         "3-state", IDC_3STATE, "BUTTON", BS_AUTO3STATE | WS_TABSTOP, 12, 59, 80, 12

    LTEXT           "Edycja:", -1, 105, 8, 40, 8
    EDITTEXT        IDC_EDIT, 145, 6, 105, 12, ES_AUTOHSCROLL
    EDITTEXT        IDC_MULTI, 105, 22, 145, 36, ES_MULTILINE | WS_VSCROLL
    LTEXT           "Liczba:", -1, 105, 64, 40, 8
    EDITTEXT        IDC_NUMBER, 145, 62, 50, 12

    LISTBOX         IDC_LIST, 5, 85, 95, 50, LBS_NOTIFY | LBS_SORT | WS_VSCROLL | WS_BORDER
    COMBOBOX        IDC_COMBO, 105, 85, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    COMBOBOX        IDC_COMBOEDIT, 105, 102, 90, 60, CBS_DROPDOWN | WS_VSCROLL
    SCROLLBAR       IDC_SCROLL, 105, 120, 145, 10
    ICON            IDI_APP, IDC_APPICON, 220, 85, 18, 20
    CTEXT           "stan: -", IDC_STATUS, 5, 140, 190, 8

    DEFPUSHBUTTON   "OK", IDOK, 200, 150, 50, 14
    PUSHBUTTON      "Anuluj", IDCANCEL, 145, 150, 50, 14
END
