#include <windows.h>
#include "resource.h"

IDI_APP ICON "src/i486ss.ico"

STRINGTABLE
BEGIN
    NAME,        "Flaga i486"
    DESCRIPTION, "Wygaszacz ekranu z powiewajaca flaga i486 DX"
END

IDD_CONFIG DIALOG 20, 20, 180, 115
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ustawienia Flagi i486"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT         "Predkosc:", -1, 10, 15, 45, 8
    SCROLLBAR     IDC_SPEED, 60, 13, 60, 10, SBS_HORZ | WS_TABSTOP
    LTEXT         "3", IDC_SPEED_VAL, 126, 15, 45, 8

    LTEXT         "Gwiazdy:", -1, 10, 35, 45, 8
    SCROLLBAR     IDC_STARS, 60, 33, 60, 10, SBS_HORZ | WS_TABSTOP
    LTEXT         "Brak", IDC_STARS_VAL, 126, 35, 48, 8

    LTEXT         "Falowanie:", -1, 10, 55, 45, 8
    SCROLLBAR     IDC_WAVE, 60, 53, 60, 10, SBS_HORZ | WS_TABSTOP
    LTEXT         "2", IDC_WAVE_VAL, 126, 55, 45, 8

    DEFPUSHBUTTON "OK",     IDOK,     65, 85, 40, 14
    PUSHBUTTON    "Anuluj", IDCANCEL, 115, 85, 40, 14
END
