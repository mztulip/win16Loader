#include <windows.h>

1 DIALOG 10, 10, 200, 150
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | DS_MODALFRAME
CAPTION "Klawisze dialogu"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "abcd", 100, "EDIT", WS_BORDER | WS_TABSTOP, 5, 5, 90, 12
    COMBOBOX        101, 5, 20, 90, 60, CBS_DROPDOWN | WS_TABSTOP
    LISTBOX         102, 100, 5, 90, 40, WS_BORDER | WS_TABSTOP
    COMBOBOX        104, 100, 85, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    EDITTEXT        103, 100, 50, 90, 30, ES_MULTILINE | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 5, 130, 40, 14, WS_TABSTOP
    PUSHBUTTON      "Anuluj", IDCANCEL, 50, 130, 40, 14, WS_TABSTOP
END
