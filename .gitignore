# Obrazy dysków i duże binaria
*.img
FD14-FloppyEdition/
FD14-FloppyEdition.zip

# Pliki kompilacji (możliwe do odtworzenia przez make)
*.o
*.obj
*.com
*.bin
*.lst
*.err
*.log

# Binaria wynikowe (odtwarzalne przez make), ale zachowaj .exe DLL-y i apki testowe
steps/STEP[0-9]/loader.exe
steps/STEP1[0-9]/loader.exe

# Biezacy build w katalogu glownym
/kernel.exe
/gdi.exe
/loader.exe

# Python cache
__pycache__/
*.pyc

# Lokalne ustawienia Claude Code
.claude/

# Wyniki budowania nowych modulow i aplikacji przykladowych (make / make example_apps)
gdi/GDI.EXE
user/USER.EXE
dlls/*.DLL
dlls/*.DRV
example_apps/*/*.EXE
*.map
*.res
# eksporty generowane przez tools/gen_lnk.py (*_imp.lnk sa pisane recznie)
gdi/gdi.lnk
user/user.lnk
dlls/[a-z]*.lnk
!dlls/dll_imp.lnk
WIN16API.DB
qemu_out/
